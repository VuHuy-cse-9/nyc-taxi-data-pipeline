MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY=minio_access_key
MINIO_SECRET_KEY=minio_secret_key

DATA_LAKE_BUCKET = "data-lake"
WAREHOUSE_BUCKET = "data-warehouse"

# Hive metadata store
METADATA_USER='hive'
METADATA_PASSWORD='hive'
METADATA_DB='metastore'
METADATA_URI="thrift://localhost:9083"

# Datasource1 DB (Green Taxi)
DATASOURCE1_HOST=localhost
DATASOURCE1_USER=datasource1
DATASOURCE1_PASSWORD=datasource1
DATASOURCE1_DB=default
DATASOURCE1_PORT=10001

# Datasource2 DB (Yellow Taxi)
DATASOURCE2_HOST=localhost
DATASOURCE2_USER=datasource1
DATASOURCE2_PASSWORD=datasource1
DATASOURCE2_DB=default
DATASOURCE2_PORT=10001

# Datasource3 DB (For-hire Vehicle)
DATASOURCE3_HOST=localhost
DATASOURCE3_USER=datasource1
DATASOURCE3_PASSWORD=datasource1
DATASOURCE3_DB=default
DATASOURCE3_PORT=10001

# Feast
FEAST_REGISTRY_URL=postgresql+psycopg://datamart_user:datamart_password@localhost:5434/feast_registry
FEAST_ONLINE_STORE=localhost:6379

# Datamart DB
DATAMART_ENDPOINT=localhost
DATAMART_PORT=5434
DATAMART_USER='datamart_user'
DATAMART_PASSWORD='datamart_password'
DATAMART_DB="datamart"


DEBEZIUM_VERSION=3.1.3.Final

# AIRFLOW
AIRFLOW_PROJ_DIR=./airflow
AIRFLOW_UID=501


# FEATURE STORE
AWS_ACCESS_KEY_ID=minio_access_key
AWS_SECRET_ACCESS_KEY=minio_secret_key
AWS_ENDPOINT_URL=http://localhost:9000
AWS_S3_ALLOW_UNSAFE_RENAME=true